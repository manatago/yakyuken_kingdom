extends SceneTree

# Stable reference frame, generated by the actual Godot scene and original builders.
func _initialize() -> void:
    call_deferred("capture")

func capture() -> void:
    var args := OS.get_cmdline_user_args()
    if args.size() != 3:
        push_error("Expected sequence ID, command cursor and screenshot path")
        quit(1)
        return
    var story = load("res://story/DefaultStory.gd").new()
    var sequence = story.get_sequence(args[0])
    var cursor := int(args[1])
    if sequence == null or cursor < 0 or cursor > sequence.entries.size():
        push_error("Invalid reference capture checkpoint")
        quit(1)
        return
    var scene = load("res://StoryScene.tscn").instantiate()
    root.add_child(scene)
    scene.set_cast(story.get_cast())
    await process_frame
    for i in range(cursor):
        var entry = sequence.entries[i]
        if entry is StoryCommands.Battle:
            push_error("Reference capture cannot silently pass a battle")
            quit(1)
            return
        if entry is StoryCommands.Band or entry is StoryCommands.Line:
            entry.wait_for_input = false
        var result = entry.execute(scene)
        if result is Signal:
            await result
    await create_timer(1.0).timeout
    await RenderingServer.frame_post_draw
    var error = root.get_texture().get_image().save_png(args[2])
    if error != OK:
        push_error("Screenshot failed: " + str(error))
        quit(1)
        return
    print("Captured original frame: ", args[0], ":", cursor)
    for side in ["LeftChar", "CenterChar", "RightChar"]:
        var rect = scene.get_node(side)
        if rect.visible:
            print(side, " position=", rect.position, " size=", rect.size, " scale=", rect.scale)
    quit(0)
