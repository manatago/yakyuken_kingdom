  "stories": [
    {
      "id": "story.subevent2.pre",
      "start_id": "subevent2.pre.background",
      "steps": [
        { "id": "subevent2.pre.background", "kind": "background", "asset_id": "background.subevent2.exterior", "next_id": "subevent2.pre.receptionist" },
        { "id": "subevent2.pre.receptionist", "kind": "line", "speaker_id": "受付嬢", "text": "聖アレクシア教会の更衣室に覗き穴があるという相談が届きました。現地で事実を確かめてください。", "next_id": "subevent2.pre.hero" },
        { "id": "subevent2.pre.hero", "kind": "line", "speaker_id": "サトシ", "text": "俺が調査を？ 分かりました。まずは教会の人から話を聞いてみます。", "next_id": "subevent2.pre.pisuke" },
        { "id": "subevent2.pre.pisuke", "kind": "line", "speaker_id": "ピー助", "text": "まずは普通に中で情報を集めろ。証拠を見つけても、余計なことはするなよ。", "next_id": "subevent2.pre.interior" },
        { "id": "subevent2.pre.interior", "kind": "background", "asset_id": "background.subevent2.interior", "next_id": "subevent2.pre.witness" },
        { "id": "subevent2.pre.witness", "kind": "line", "speaker_id": "若いシスター", "text": "ギルドの方ですね。更衣室の壁の穴から、隣の特別礼拝室を覗けるようになっています。", "next_id": "subevent2.pre.backyard" },
        { "id": "subevent2.pre.backyard", "kind": "background", "asset_id": "background.subevent2.backyard", "next_id": "subevent2.pre.hero-promise" },
        { "id": "subevent2.pre.hero-promise", "kind": "line", "speaker_id": "サトシ", "text": "それで献金額が増えていたのか……。証拠を押さえて、シスター長にやめさせます。", "next_id": "subevent2.pre.corridor" },
        { "id": "subevent2.pre.corridor", "kind": "background", "asset_id": "background.subevent2.corridor", "next_id": "subevent2.pre.lock" },
        { "id": "subevent2.pre.lock", "kind": "line", "speaker_id": "ピー助", "text": "隣の特別礼拝室だ。帳簿を見つけたら記録して、すぐギルドへ持ち帰るぞ。", "next_id": "subevent2.pre.room" },
        { "id": "subevent2.pre.room", "kind": "background", "asset_id": "background.subevent2.peep-room", "next_id": "subevent2.pre.ledger" },
        { "id": "subevent2.pre.ledger", "kind": "line", "speaker_id": "サトシ", "text": "顧客名簿を見つけた。これなら不正を証明できる！", "next_id": "subevent2.pre.sister" },
        { "id": "subevent2.pre.sister", "kind": "show_portrait", "slot_id": "sister-head", "asset_id": "portrait.subevent2.sister-head", "layout_id": "layout.subevent2.sister-head", "next_id": "subevent2.pre.confrontation" },
        { "id": "subevent2.pre.confrontation", "kind": "line", "speaker_id": "シスター長", "text": "その帳簿を見てしまったのね。……それを持ち帰らせるわけにはいきません。", "next_id": "subevent2.pre.challenge" },
        { "id": "subevent2.pre.challenge", "kind": "line", "speaker_id": "ピー助", "text": "勝負で真実を決めるんだ。勝てば帳簿を持ち帰る。負けたら、いったん退くしかない。", "next_id": "subevent2.battle.start" },
        { "id": "subevent2.battle.start", "kind": "battle", "battle_id": "battle.subevent2.sister-head", "next_id": "subevent2.post.background" }
      ]
    },
    {
      "id": "story.subevent2.post",
      "start_id": "subevent2.post.background",
      "steps": [
        { "id": "subevent2.post.background", "kind": "background", "asset_id": "background.subevent2.interior", "next_id": "subevent2.post.admission" },
        { "id": "subevent2.post.admission", "kind": "line", "speaker_id": "シスター長", "text": "……私の負けです。帳簿も、もう隠せませんね。", "next_id": "subevent2.post.hero" },
        { "id": "subevent2.post.hero", "kind": "line", "speaker_id": "サトシ", "text": "これで不正は明らかになりました。帳簿はギルドへ届けます。", "next_id": "subevent2.post.receptionist" },
        { "id": "subevent2.post.receptionist", "kind": "line", "speaker_id": "受付嬢", "text": "調査報告を確認しました。教会の件は、ギルドから正式に対応します。ご苦労さまでした。", "next_id": "subevent2.post.end" },
        { "id": "subevent2.post.end", "kind": "end" }
      ]
    },
    {
      "id": "story.subevent2.loss",
      "start_id": "subevent2.loss.end",
      "steps": [
        { "id": "subevent2.loss.end", "kind": "end" }
      ]
    }
  ]
}
