  "stories": [{
    "id": "story.subevent1.jin",
    "start_id": "subevent1.jin.background",
    "steps": [
      { "id": "subevent1.jin.background", "kind": "background", "asset_id": "background.subevent1.jin", "next_id": "subevent1.jin.intro" },
      { "id": "subevent1.jin.intro", "kind": "line", "speaker_id": "ジン", "text": "へっ、来たな冒険者。アジトの場所を嗅ぎつけるとは、やるじゃねえか。だが、ここから先は通さねえぜ。", "next_id": "subevent1.jin.warning" },
      { "id": "subevent1.jin.warning", "kind": "line", "speaker_id": "ピー助", "text": "こいつのデッキ、スキャンしたぞ。チョキに偏ってる典型的なスピード型だ。グーで押せば楽勝だ。", "next_id": "subevent1.jin.challenge" },
      { "id": "subevent1.jin.challenge", "kind": "line", "speaker_id": "ジン", "text": "余裕ぶってんじゃねえぞ！ 俺の「疾風のハサミ」を食らいな！", "next_id": "subevent1.jin.await" },
      { "id": "subevent1.jin.await", "kind": "battle", "battle_id": "battle.subevent1.jin", "next_id": "subevent1.jin.after" },
      { "id": "subevent1.jin.after", "kind": "line", "speaker_id": "サトシ", "text": "だからチョキばっかりだって言ったのに。", "next_id": "subevent1.marco.approach" },
      { "id": "subevent1.marco.approach", "kind": "line", "speaker_id": "ピー助", "text": "ゲコッ。もう1人いるぞ。この先の角だ。...今度はさっきより手強い。", "next_id": "subevent1.marco.silent" },
      { "id": "subevent1.marco.silent", "kind": "line", "speaker_id": "マルコ", "text": "......。", "next_id": "subevent1.marco.warning" },
      { "id": "subevent1.marco.warning", "kind": "line", "speaker_id": "ピー助", "text": "こいつ、さっきのとは違うぞ。デッキのバランスがいい。グー・チョキ・パーが均等に入ってる。...偏りがないから、ベイズ・アイでも読みにくい。慎重にいけ。", "next_id": "subevent1.marco.challenge" },
      { "id": "subevent1.marco.challenge", "kind": "line", "speaker_id": "サトシ", "text": "...行くぞ。", "next_id": "subevent1.marco.await" },
      { "id": "subevent1.marco.await", "kind": "battle", "battle_id": "battle.subevent1.marco", "next_id": "subevent1.marco.after" },
      { "id": "subevent1.marco.after", "kind": "line", "speaker_id": "サトシ", "text": "なんか、言えよ。ていうか、前を隠せよ...", "next_id": "subevent1.marco.report" },
      { "id": "subevent1.marco.report", "kind": "line", "speaker_id": "ピー助", "text": "2人片付けた。あとはアジトの中だ。...残り2人と、首領だな。気を引き締めろ。", "next_id": "subevent1.marco.end" },
      { "id": "subevent1.marco.end", "kind": "end" },
      { "id": "subevent1.jin.end", "kind": "end" }
    ]
  }]
