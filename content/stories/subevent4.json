  "stories": [
    {
      "id": "story.subevent4.pre",
      "start_id": "subevent4.pre.background",
      "steps": [
        { "id": "subevent4.pre.background", "kind": "background", "asset_id": "background.subevent4.guild", "next_id": "subevent4.pre.notice" },
        { "id": "subevent4.pre.notice", "kind": "line", "speaker_id": "受付嬢", "text": "サトシ様には未確認事項を含む行動記録が重なっています。規約に従い、公開の審査を行います。", "next_id": "subevent4.pre.hero" },
        { "id": "subevent4.pre.hero", "kind": "line", "speaker_id": "サトシ", "text": "説明の機会をください。記録に誤りがあれば、正します。", "next_id": "subevent4.pre.pisuke" },
        { "id": "subevent4.pre.pisuke", "kind": "line", "speaker_id": "ピー助", "text": "規約には、審査担当とのカード勝負で判断を再確認する条項がある。勝負は記録され、結果は双方に開示される。", "next_id": "subevent4.pre.receptionist" },
        { "id": "subevent4.pre.receptionist", "kind": "show_portrait", "slot_id": "受付嬢", "asset_id": "portrait.subevent4.receptionist", "layout_id": "layout.subevent4.receptionist", "next_id": "subevent4.pre.accept" },
        { "id": "subevent4.pre.accept", "kind": "line", "speaker_id": "受付嬢", "text": "申請を受理します。勝敗にかかわらず、規約に沿って記録を訂正し、必要な説明を行います。", "next_id": "subevent4.pre.end" },
        { "id": "subevent4.pre.end", "kind": "end" }
      ]
    },
    {
      "id": "story.subevent4.battle",
      "start_id": "subevent4.battle.start",
      "steps": [
        { "id": "subevent4.battle.start", "kind": "battle", "battle_id": "battle.subevent4.receptionist", "next_id": "subevent4.post.background" }
      ]
    },
    {
      "id": "story.subevent4.post",
      "start_id": "subevent4.post.background",
      "steps": [
        { "id": "subevent4.post.background", "kind": "background", "asset_id": "background.subevent4.guild", "next_id": "subevent4.post.result" },
        { "id": "subevent4.post.result", "kind": "line", "speaker_id": "受付嬢", "text": "勝負の結果と証言を照合しました。記録の不備を訂正し、審査結果を正式に更新します。", "next_id": "subevent4.post.hero" },
        { "id": "subevent4.post.hero", "kind": "line", "speaker_id": "サトシ", "text": "勝負だけで決めつけず、記録を見直してもらえてよかったです。", "next_id": "subevent4.post.reward" },
        { "id": "subevent4.post.reward", "kind": "line", "speaker_id": "受付嬢", "text": "審査の協力報酬です。今後は双方が確認できる記録方式に改めます。", "next_id": "subevent4.post.end" },
        { "id": "subevent4.post.end", "kind": "end" }
      ]
    },
