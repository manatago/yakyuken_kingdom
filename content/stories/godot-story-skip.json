    {
      "background": "res://assets/backgrounds/prologue/bg03-1_lab.png",
      "cursor": 50,
      "dialogue": {
        "band_visible": true,
        "l_body": "ここが噂の研究施設...SPring-8にそっくりじゃないか。",
        "l_speaker": "サトシ",
        "l_speaker_vis": true,
        "l_visible": true,
        "n_body": "スマホが震えた。みのりからのメッセージだ。",
        "n_body_vis": false,
        "n_speaker": "Speaker",
        "n_speaker_vis": false,
        "r_body": "あんたの大学のサイトに出てたけど、「大型加速器実験補助、履修認定あり」って募集、知ってる？\n締切明日までだって。",
        "r_speaker": "みのり",
        "r_speaker_vis": false,
        "r_visible": false
      },
      "end_cursor": 64,
      "position_cache": {
        "main": "(0.0, 0.0)"
      },
