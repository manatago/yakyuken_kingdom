    {
      "background": "res://assets/backgrounds/prologue/bg02_room.png",
      "cursor": 15,
      "dialogue": {
        "band_visible": true,
        "l_body": "（部屋はエロゲ箱と数学書が大和積まれている。俺の人生を縮図みたく語ってくれるインスタレーションアートだ。）",
        "l_speaker": "サトシ",
        "l_speaker_vis": true,
        "l_visible": true,
        "n_body": "一方、幼馴染の女の子は有名私大の弁論サークルに所属しており、政治家秘書のバイトをやっており、将来は政治家を目指している。弁論大会で多数の受賞歴を誇る。",
        "n_body_vis": false,
        "n_speaker": "Speaker",
        "n_speaker_vis": false,
        "r_body": "あ、サトシ。こんなとこでブラブラして...また講義サボったでしょ。",
        "r_speaker": "みのり",
        "r_speaker_vis": false,
        "r_visible": false
      },
      "end_cursor": 47,
      "position_cache": {
        "main": "(0.0, 0.0)"
      },
