    {
      "background": "res://assets/backgrounds/prologue/bg05_prison_cell.png",
      "cursor": 105,
      "dialogue": {
        "band_visible": true,
        "l_body": "ちょっ、まっ、まって。いたい、いたい、、、",
        "l_speaker": "サトシ",
        "l_speaker_vis": false,
        "l_visible": false,
        "n_body": "サトシが気が付くと、そこは牢の中だった。服が着せられていた。",
        "n_body_vis": true,
        "n_speaker": "サトシ",
        "n_speaker_vis": false,
        "r_body": "何の騒ぎだ。...おい、そこの露出狂の変態！ 何してやがる。",
